---
import Common from "../layouts/Common.astro";
import { SITE_META } from "../constants/siteMeta";

const site = Astro.site ?? new URL(SITE_META.siteUrl);
const feedUrl = new URL("/atom.xml", site).href;
---

<Common
  title="Subscribe | Ayman El Didi"
  description="How to subscribe to Ayman El Didi's Atom feed."
>
  <section class="subscribe">
    <h1>How to Subscribe</h1>
    <p>
      This site publishes an Atom feed so you can follow new posts in any feed
      reader.
    </p>
    <p>
      You should be able to just point your feed reader at
      <code>ayman.eldidi.org</code>, but the feed url is <code>{feedUrl}</code>
      if that doesn't work.
    </p>
    <p>
      To subscribe, open your reader, choose "Add Feed" (or similar), and paste
      the URL above.
    </p>
    <p>Examples of readers that support feeds:</p>
    <ul class="subscribe__list">
      <li>Feedly (web)</li>
      <li>NetNewsWire (macOS and iOS)</li>
      <li>Inoreader (web)</li>
    </ul>
  </section>
</Common>

<style>
  .subscribe h1 {
    margin-top: 0;
  }

  .subscribe__list {
    margin: var(--space-3) 0 0;
  }
</style>
