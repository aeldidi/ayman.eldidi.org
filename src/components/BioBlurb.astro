---
import { SITE_META } from "../constants/siteMeta";
---

<section class="blurb" aria-label="About the author">
  <p>{SITE_META.bio}</p>
  <p>
    If that sounds interesting to you, check out my
    <a href={SITE_META.github} target="_blank" rel="noreferrer noopener">
      GitHub
    </a>
    and get in touch at
    <a href={`mailto:${SITE_META.email}`}>{SITE_META.email}</a>.
  </p>
  <div class="blurb__actions">
    <a class="blurb__subscribe" href="/subscribe/">Subscribe via Feed</a>
    <span class="blurb__hint">
      Prefer a reader? Use the RSS feed at <a href="/rss.xml">/rss.xml</a>.
    </span>
  </div>
</section>

<style>
  .blurb {
    border: var(--border-thin) dashed var(--color-border-subtle);
    padding: var(--space-3) var(--space-4);
    background: transparent;
    font-size: var(--font-size-base);
    box-shadow: var(--shadow-subtle);
  }

  .blurb strong {
    font-weight: 600;
  }

  .blurb__actions {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .blurb__subscribe {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border: var(--border-thin) solid var(--color-border-strong);
    background: var(--color-surface-alt);
    color: var(--color-heading);
    font-weight: 600;
    text-decoration: none;
    text-transform: none;
  }

  .blurb__subscribe:hover,
  .blurb__subscribe:focus-visible {
    background: var(--color-surface);
    text-decoration: underline;
  }

  .blurb__hint {
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
  }
</style>
