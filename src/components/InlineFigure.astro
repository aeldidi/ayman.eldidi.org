---
import type { ImageMetadata } from "astro";
import type { InlineFigureRegistry } from "../lib/inlineFigureRegistry";

type Props = {
  id: string;
  src: string | ImageMetadata;
  caption: string;
  registry: InlineFigureRegistry;
  href?: string;
  width?: number | string;
  height?: number | string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  className?: string;
  showNumber?: boolean;
};

const {
  id,
  src,
  caption,
  registry,
  href,
  width,
  height,
  loading = "lazy",
  decoding = "async",
  className,
  showNumber = true,
} = Astro.props as Props;

const resolvedSrc = typeof src === "string" ? src : src.src;
const number = showNumber ? registry.register(id) : undefined;

const cssWidth = typeof width === "number" ? `${width}px` : (width ?? "auto");
const cssHeight =
  typeof height === "number" ? `${height}px` : (height ?? "auto");
const imgStyle = `max-width:100%;width:${cssWidth};height:${cssHeight};display:block;`;

const metadataWidth = typeof src === "string" ? undefined : src.width;
const metadataHeight = typeof src === "string" ? undefined : src.height;
const hasExplicitSize = width !== undefined || height !== undefined;
const attributeWidth =
  typeof width === "number"
    ? width
    : hasExplicitSize
      ? undefined
      : metadataWidth;
const attributeHeight =
  typeof height === "number"
    ? height
    : hasExplicitSize
      ? undefined
      : metadataHeight;

const figureClassName = className ? `figure ${className}` : "figure";
---

<figure class={figureClassName} data-figure-id={id} data-figure-number={number}>
  <a href={href ?? resolvedSrc} target="_blank" rel="noopener noreferrer">
    <img
      src={resolvedSrc}
      alt={caption}
      style={imgStyle}
      width={attributeWidth}
      height={attributeHeight}
      loading={loading}
      decoding={decoding}
    />
  </a>
  <figcaption class="caption">
    {
      showNumber ? (
        <span style="font-weight: 600;">Figure {number}.</span>
      ) : null
    }
    {showNumber ? " " : ""}
    {caption}
  </figcaption>
</figure>

<style>
  .figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .figure a {
    display: inline-block;
    max-width: 100%;
    text-decoration: none;
  }

  .caption {
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-tight);
  }
</style>
