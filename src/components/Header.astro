---
import { SITE_META } from "../constants/siteMeta";
import blueprintBgWhite from "../assets/texture/blueprint-bg-white.svg";
import blueprintGrain from "../assets/texture/blueprint-paper-grain-header.svg";

const { pathname } = Astro.url;
const navItems = [
  { href: "/", label: "Articles" },
  { href: "/work/", label: "Work" },
  { href: "/about/", label: "About" },
];
const normalizePath = (path: string) =>
  path === "/" ? "/" : path.replace(/\/$/, "");
const currentPath = normalizePath(pathname);
const isActive = (href: string) => {
  const normalizedHref = normalizePath(href);
  if (normalizedHref === "/") {
    return (
      currentPath === "/" ||
      currentPath.startsWith("/articles") ||
      currentPath.startsWith("/drafts")
    );
  }
  return (
    currentPath === normalizedHref ||
    currentPath.startsWith(`${normalizedHref}/`)
  );
};

const resolveTextureUrl = (asset: string | { src: string }) =>
  typeof asset === "string" ? asset : asset.src;

const textureVars = {
  textureBlueprintGrid: `url(${resolveTextureUrl(blueprintBgWhite)})`,
  textureBlueprintGrain: `url(${resolveTextureUrl(blueprintGrain)})`,
};
---

<header class="header">
  <div class="content">
    <div class="identity">
      <a class="name" href="/">{SITE_META.name}</a>
    </div>
    <nav class="nav" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : null}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style define:vars={textureVars}>
  .header {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: var(--space-5) 0 var(--space-4);
    position: relative;
    z-index: 2;
    background-color: var(--color-blueprint);
    background-image: var(--textureBlueprintGrain), var(--textureBlueprintGrid);
    background-repeat: repeat, repeat;
    background-size:
      512px 512px,
      240px 240px;
    background-position:
      left bottom,
      left bottom;
    background-origin: border-box;
    box-shadow:
      0 2px 6px rgba(15, 23, 42, 0.12),
      0 10px 22px rgba(15, 23, 42, 0.08);
  }

  .header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 2px;
    background-image: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.4) 0,
      rgba(255, 255, 255, 0.4) 6px,
      transparent 6px,
      transparent 10px
    );
    background-repeat: repeat-x;
    background-size: 10px 2px;
    pointer-events: none;
  }

  .content {
    width: min(var(--content-base), 92vw);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .name {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: #f8fbff;
    text-decoration: none;
  }

  .name:visited {
    color: #f8fbff;
    text-decoration: none;
  }

  .name:hover {
    text-decoration: underline;
  }

  .nav {
    display: flex;
    gap: var(--space-5);
    font-size: var(--font-size-base);
    font-weight: 600;
  }

  .nav a {
    color: rgb(248, 251, 255);
    text-decoration-color: rgb(248, 251, 255, 0.45);
    text-decoration-thickness: 1px;
  }

  .nav a:visited {
    color: rgba(248, 251, 255, 0.92);
    text-decoration-color: rgb(248, 251, 255);
  }

  .nav a:hover {
    text-decoration-thickness: 2px;
  }

  .nav a[aria-current="page"] {
    text-decoration-color: rgba(348, 351, 255, 0.8);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 600px) {
    .nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
