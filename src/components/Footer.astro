---
import { SITE_META } from "../constants/siteMeta";

// const year = new Date().getFullYear();
---

<footer class="footer">
  <p class="footer__note">{SITE_META.publicDomainNote}</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    justify-content: space-between;
  }

  .footer p {
    margin: 0;
  }

  @media (max-width: 600px) {
    .footer__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
